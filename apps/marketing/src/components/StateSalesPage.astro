---
/**
 * State sales-tax cadence hub — B2a of the state×tax matrix (spec:
 * docs/marketing/state-form-matrix-spec-2026-07-31.md). One card per verified
 * state from lib/state-sales-rows.ts, each with its official agency source
 * linked and a cross-link to the state's own page. Static render, no client JS.
 */
import { getCtaHref } from '../lib/app-url'
import { STATE_SALES_ROWS, STATE_SALES_ROWS_VERIFIED_ON } from '../lib/state-sales-rows'

interface Props {
  locale: 'en' | 'zh-CN'
}
const { locale } = Astro.props
const zh = locale === 'zh-CN'
const prefix = zh ? '/zh-CN' : ''

const copy = zh
  ? {
      eyebrow: '核实参考',
      title: '各州销售税申报截止日（2026）',
      lead: '「次月 20 日」并不是普适规则:加州是月末、俄亥俄 23 日、华盛顿 25 日,纽约的季度根本不是日历季度。12 个大州的申报节奏,每条转录自州税务机关官方页面并附来源——两遍独立核实。',
      dueLabel: '截止规则',
      freqLabel: '频率怎么定',
      noteLabel: '别记错',
      source: '官方来源',
      statePage: '查看该州全部截止日',
      verified: `核实于 ${STATE_SALES_ROWS_VERIFIED_ON}（两遍独立转录后比对;两遍口径不一致的细节未发布）。申报前请以官方来源为准,本页不构成税务建议。`,
      ctaLead: '销售税节奏因州而异,还会变——统一「20 号」的提醒日历在 4 个州是错的。',
      ctaText: 'DueDateHQ 监控官方 IRS 与各州来源,规则或截止日变动时把变化路由到受影响的客户。Beta 期间免费。',
      ctaBtn: '免费开始',
    }
  : {
      eyebrow: 'VERIFIED REFERENCE',
      title: 'State sales tax filing due dates (2026)',
      lead: '"The 20th of the following month" is not a universal rule: California uses month-end, Ohio the 23rd, Washington the 25th, and New York’s quarters aren’t calendar quarters at all. Filing cadence for 12 major states, each transcribed from the state agency page linked beside it — independently verified twice.',
      dueLabel: 'Due rule',
      freqLabel: 'How frequency is assigned',
      noteLabel: 'Don’t get this wrong',
      source: 'Official source',
      statePage: 'All deadlines for this state',
      verified: `Verified ${STATE_SALES_ROWS_VERIFIED_ON} (two independent transcription passes, diffed; details the passes stated differently were not published). Confirm against the official source before filing — not tax advice.`,
      ctaLead: 'Sales-tax cadence differs by state and moves — a one-size "20th" tickler is wrong in four of these states.',
      ctaText: 'DueDateHQ watches official IRS and state sources and routes each rule or deadline change to the clients it affects. Free during beta.',
      ctaBtn: 'Start free',
    }

const appHref = getCtaHref(locale)
---

<section class="sst">
  <div class="wrap">
    <p class="m-eyebrow">{copy.eyebrow}</p>
    <h1 class="m-page-title">{copy.title}</h1>
    <p class="sst__lead">{copy.lead}</p>

    <div class="sst__grid">
      {
        STATE_SALES_ROWS.map((r) => (
          <article class="sst__card">
            <h2 class="sst__state">{r.state}</h2>
            <dl class="sst__facts">
              <div>
                <dt>{copy.dueLabel}</dt>
                <dd>{zh ? r.dueZh : r.due}</dd>
              </div>
              {r.freq && (
                <div>
                  <dt>{copy.freqLabel}</dt>
                  <dd>{zh ? (r.freqZh ?? r.freq) : r.freq}</dd>
                </div>
              )}
              {r.note && (
                <div>
                  <dt>{copy.noteLabel}</dt>
                  <dd>{zh ? (r.noteZh ?? r.note) : r.note}</dd>
                </div>
              )}
            </dl>
            <p class="sst__links">
              <a href={r.sourceHref} target="_blank" rel="noopener">
                {copy.source}: {r.sourceLabel}
              </a>
              <a href={`${prefix}/states/${r.stateSlug}`}>{copy.statePage} &rarr;</a>
            </p>
          </article>
        ))
      }
    </div>

    <p class="sst__note">{copy.verified}</p>

    <div class="sst__cta">
      <p class="sst__cta-lead">{copy.ctaLead}</p>
      <p class="sst__cta-text">{copy.ctaText}</p>
      <a class="m-btn m-btn--secondary" href={appHref} data-event="marketing.sales-hub.cta"
        >{copy.ctaBtn}</a
      >
    </div>
  </div>
</section>

<style>
  .sst {
    padding-block: clamp(48px, 7vw, 88px) 8px;
  }
  .sst .wrap {
    max-width: var(--m-maxw);
    margin-inline: auto;
    padding-inline: var(--m-gutter);
  }
  .sst__lead {
    margin-top: 14px;
    max-width: 68ch;
    font-size: var(--m-text-base);
    line-height: 1.6;
    color: var(--m-ink-2);
  }
  .sst__grid {
    margin-top: clamp(28px, 4vw, 40px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 860px) {
    .sst__grid {
      grid-template-columns: 1fr;
    }
  }
  .sst__card {
    border: 1px solid var(--m-hairline);
    border-radius: 12px;
    padding: 18px 20px;
    background: var(--m-surface, #fff);
  }
  .sst__state {
    margin: 0;
    font-size: var(--m-text-base);
    font-weight: 600;
    color: var(--m-ink);
  }
  .sst__facts {
    margin: 12px 0 0;
    display: grid;
    gap: 10px;
  }
  .sst__facts dt {
    font-size: var(--m-text-2xs);
    font-weight: 600;
    letter-spacing: var(--m-ls-eyebrow);
    text-transform: uppercase;
    color: var(--m-faint);
  }
  .sst__facts dd {
    margin: 2px 0 0;
    font-size: var(--m-text-sm, 0.9rem);
    line-height: 1.55;
    color: var(--m-ink);
  }
  .sst__links {
    margin: 14px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: var(--m-text-xs);
  }
  .sst__links a {
    color: var(--m-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sst__note {
    margin-top: 26px;
    max-width: 80ch;
    font-size: var(--m-text-xs);
    line-height: 1.55;
    color: var(--m-muted);
  }
  .sst__cta {
    margin-top: 32px;
    border: 1px solid var(--m-hairline);
    border-radius: 12px;
    padding: 22px;
    background: var(--m-section);
  }
  .sst__cta-lead {
    margin: 0;
    font-weight: 600;
    color: var(--m-ink);
  }
  .sst__cta-text {
    margin: 8px 0 14px;
    max-width: 68ch;
    font-size: var(--m-text-sm, 0.9rem);
    line-height: 1.6;
    color: var(--m-ink-2);
  }
</style>
