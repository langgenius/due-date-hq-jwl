---
/**
 * /w2-filing-deadlines — state W-2 / annual withholding reconciliation hub
 * (state×tax matrix B3a). Verified twice per row; sources on every card.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import TopNav from '../components/home/TopNav.astro'
import Footer from '../components/home/Footer.astro'
import StateW2Page from '../components/StateW2Page.astro'
import { getStartedHref } from '../lib/app-url'
import { getContentDates } from '../lib/content-metadata'
import { MARKETING_SITE_URL } from '../lib/site'
import type { JsonLdDocument } from '../lib/structured-data'

const locale = 'en'
const pathname = '/w2-filing-deadlines'
const title = 'State W-2 Filing Deadlines 2026: 12 States, Verified'
const description =
  'Mostly January 31 — but New Jersey is February 15, and California and New York take no state W-2 at all. Official source on every row.'
const { publishedOn, reviewedOn } = getContentDates('w2-filing-deadlines')
const faq = [
  {
    q: 'When are W-2s due to the state?',
    a: 'In most states that require them, January 31 following the tax year (Illinois, Pennsylvania, Georgia, North Carolina, Ohio, Michigan). New Jersey’s NJ-W-3 runs to February 15. California and New York require no state W-2 filing at all — wage detail is reported on quarterly returns (DE 9/DE 9C and NYS-45) instead.',
  },
  {
    q: 'Does California require employers to file W-2s with the state?',
    a: 'No. The EDD’s Employer’s Guide (DE 44) states W-2s are not filed with the state; employers report wage and withholding detail quarterly on the DE 9 and DE 9C, electronically.',
  },
  {
    q: 'Which states have no state income tax withholding?',
    a: 'Texas and Florida impose no personal income tax, so there is no state W-2 filing. Washington historically had none either — but the legislature enacted ESSB 6346 ("Establishing a tax on millionaires," Chapter 238, Laws of 2026, signed March 30, 2026), an income tax on individuals with AGI of $1,000,000 or more. It is an individual obligation; no employer withholding requirement has been stated by the DOR.',
  },
  {
    q: 'What happens if NC-3 or the W-2s are filed late or on paper in North Carolina?',
    a: 'North Carolina’s e-file mandate carries a $200 penalty for filing in a format other than the prescribed electronic one, plus a late-filing penalty of $50 per day up to $1,000.',
  },
]
const structuredData: JsonLdDocument = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${MARKETING_SITE_URL}${pathname}#webpage`,
      url: `${MARKETING_SITE_URL}${pathname}`,
      name: title,
      description,
      inLanguage: locale,
      datePublished: publishedOn,
      dateModified: reviewedOn,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${MARKETING_SITE_URL}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'W-2 filing deadlines',
          item: `${MARKETING_SITE_URL}${pathname}`,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
}
const ctaHref = getStartedHref()
---

<BaseLayout
  lang={locale}
  pathname={pathname}
  title={title}
  description={description}
  ogImage="/og/coverage.en.png"
  ogType="article"
  structuredData={structuredData}
>
  <TopNav pageMode ctaHref={ctaHref} current="coverage" />
  <StateW2Page locale={locale} />
  <section class="swf">
    <div class="wrap">
      <p class="m-eyebrow">FAQ</p>
      <h2 class="m-page-h2">State W-2 questions</h2>
      {
        faq.map((f) => (
          <details class="swf__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
      <p class="swf__more">
        Sales tax: <a href="/sales-tax-deadlines">state sales tax due dates</a> · Franchise:{' '}
        <a href="/franchise-tax-deadlines">state franchise tax deadlines</a> · Federal payroll:{' '}
        <a href="/guides/payroll-tax-deadlines">payroll tax deadlines</a>
      </p>
    </div>
  </section>
  <Footer />
</BaseLayout>

<style>
  .swf {
    padding-block: 8px clamp(48px, 7vw, 80px);
  }
  .swf .wrap {
    max-width: var(--m-maxw);
    margin-inline: auto;
    padding-inline: var(--m-gutter);
  }
  .swf__item {
    border-bottom: 1px solid var(--m-hairline-2);
    padding: 14px 0;
  }
  .swf__item summary {
    cursor: pointer;
    font-weight: 500;
    color: var(--m-ink);
  }
  .swf__item p {
    margin: 10px 0 0;
    max-width: 70ch;
    line-height: 1.6;
    color: var(--m-ink-2);
  }
  .swf__more {
    margin-top: 20px;
    font-size: var(--m-text-sm, 0.9rem);
    color: var(--m-muted);
  }
  .swf__more a {
    color: var(--m-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
