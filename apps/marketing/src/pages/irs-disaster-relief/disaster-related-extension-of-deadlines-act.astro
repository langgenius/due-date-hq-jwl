 *
 * DATA INTEGRITY: every fact verified 2026-07-31 against congress.gov/govinfo
 * BILLSTATUS records and the enacted PLAW statute text. Sources linked in the
 * body. Note the widely-repeated "signed January 2026" claim is WRONG — the
 * official record says December 26, 2025; being the page that gets this right
 * is the point. No invented dollar examples.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import TopNav from '../../components/home/TopNav.astro'
import Footer from '../../components/home/Footer.astro'
import FaqList from '../../components/FaqList.astro'
import en from '../../i18n/en'
import { getCtaHref } from '../../lib/app-url'
import { getContentDates } from '../../lib/content-metadata'
import { disasterNoticeStructuredData } from '../../lib/structured-data'

const t = en
const pathname = '/irs-disaster-relief/disaster-related-extension-of-deadlines-act'
const slug = 'disaster-related-extension-of-deadlines-act'
const hubHref = '/irs-disaster-relief'
const ctaHref = getCtaHref('en')
const reviewedOn = getContentDates(slug).reviewedOn

const title = 'Disaster Related Extension of Deadlines Act (P.L. 119-64)'
const description =
  'Signed December 26, 2025 — not January 2026. Postponement periods now count as extensions for the §6511(b)(2)(A) refund lookback. What changed.'

const faq = [
  {
    question: 'What problem does the Disaster Related Extension of Deadlines Act fix?',
    answer:
      'A refund-lookback trap. The amount refundable on a claim is capped by the tax paid within the §6511(b)(2)(A) lookback window — three years plus any extension of time to file. A §7508A disaster postponement moved the filing date without being an "extension," so payments made in the postponed window could fall outside the lookback and become unrecoverable. The Act amends §7508A so a disregarded period is treated as an extension of time for filing for this purpose.',
  },
  {
    question: 'When was it signed, and what is the bill number?',
    answer:
      'December 26, 2025 — it is Public Law 119-64, enacted from H.R. 1491 (119th Congress), which passed the House 423-0 on April 1, 2025 and the Senate by unanimous consent on December 11, 2025. Some summaries say "January 2026"; the official record says December 26, 2025.',
  },
  {
    question: 'What does it change about IRS collection notices?',
    answer:
      'It amends §6303(b) so the timing of notice-and-demand for payment accounts for any period disregarded under §7508A — collection notices are not supposed to run on a clock that ignores a disaster postponement.',
  },
  {
    question: 'Does this change how disaster postponements themselves work?',
    answer:
      'No. The postponement mechanics (IRS newsroom releases, relief codes, covered areas, automatic application by address of record) are unchanged. What changed is what the postponement counts for downstream: refund lookback and collection-notice timing.',
  },
]
---

<BaseLayout
  lang="en"
  pathname={pathname}
  title={title}
  description={description}
  ogImage="/og/coverage.en.png"
  ogType="article"
  structuredData={disasterNoticeStructuredData(
    t,
    'en',
    pathname,
    slug,
    title,
    description,
