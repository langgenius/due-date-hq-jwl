 * /irs-disaster-relief/filing-relief-for-natural-disasters-act — reference page
 * for P.L. 119-29 (H.R. 517, enacted July 24, 2025).
 *
 * DATA INTEGRITY: every fact verified 2026-07-31 against congress.gov/govinfo
 * BILLSTATUS records and the enacted PLAW statute text, plus irs.gov for the
 * P.L. 119-21 casualty-loss companion. Sources linked in the page body. New
 * law = thin competition; identifiers (bill number, P.L. number, IRC sections)
 * are the citation hooks. No invented examples, no dollar hypotheticals.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import TopNav from '../../components/home/TopNav.astro'
import Footer from '../../components/home/Footer.astro'
import FaqList from '../../components/FaqList.astro'
import en from '../../i18n/en'
import { getCtaHref } from '../../lib/app-url'
import { getContentDates } from '../../lib/content-metadata'
import { disasterNoticeStructuredData } from '../../lib/structured-data'

const t = en
const pathname = '/irs-disaster-relief/filing-relief-for-natural-disasters-act'
const slug = 'filing-relief-for-natural-disasters-act'
const hubHref = '/irs-disaster-relief'
const ctaHref = getCtaHref('en')
const reviewedOn = getContentDates(slug).reviewedOn

const title = 'Filing Relief for Natural Disasters Act (P.L. 119-29): What Changed | DueDateHQ'
const description =
  'P.L. 119-29 (H.R. 517, enacted July 24, 2025) lets the IRS postpone federal tax deadlines for state-declared disasters at a governor’s written request, and lengthens the mandatory §7508A(e) postponement from 60 to 120 days. Verified against congress.gov.'

const faq = [
  {
    question: 'What does the Filing Relief for Natural Disasters Act do?',
    answer:
      'Two things, both amendments to IRC §7508A. First, it authorizes the IRS — upon the written request of a state’s governor and after consulting FEMA — to postpone federal tax deadlines for a qualified state-declared disaster, without waiting for a federal declaration. Second, it lengthens the mandatory automatic postponement under §7508A(e) from 60 days to 120 days.',
  },
  {
    question: 'When was it enacted, and what is the bill number?',
    answer:
      'It was signed July 24, 2025, becoming Public Law 119-29. The enacted bill is H.R. 517 (119th Congress); a companion Senate bill, S. 132, was introduced but H.R. 517 is the one that became law.',
  },
  {
    question: 'Does this mean state-declared disasters now trigger automatic IRS relief?',
    answer:
      'No — the mechanism is permissive, not automatic. The governor must request it in writing, and the IRS decides after consulting FEMA. Watch the IRS disaster-relief newsroom as before: relief exists only when the IRS announces it.',
  },
  {
    question: 'Is there related 2025 legislation CPAs should know alongside this?',
    answer:
      'Yes — P.L. 119-21 (signed July 4, 2025) made the qualified-disaster casualty-loss rules permanent and, beginning in 2026, extends the deduction to losses from state-declared disasters. Together the two laws move both deadlines and casualty-loss treatment beyond the federal-declaration-only world. See also P.L. 119-64 (December 26, 2025), which fixed the refund-lookback interaction of disaster postponements.',
  },
]
---

