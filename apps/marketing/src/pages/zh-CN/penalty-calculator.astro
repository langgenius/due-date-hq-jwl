---
/** /zh-CN/penalty-calculator — IRS 迟报罚金估算器(EN 镜像,同一核实费率源)。 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import TopNav from '../../components/home/TopNav.astro'
import Footer from '../../components/home/Footer.astro'
import PenaltyCalculator from '../../components/PenaltyCalculator.astro'
import { getStartedHref } from '../../lib/app-url'
import { getContentDates } from '../../lib/content-metadata'
import { PENALTY_FACTS } from '../../lib/penalty-facts'
import { MARKETING_SITE_URL } from '../../lib/site'
import type { JsonLdDocument } from '../../lib/structured-data'

const locale = 'zh-CN'
const pathname = '/zh-CN/penalty-calculator'
const title = 'IRS 迟报罚金估算器（2026）：1040、1065、1120-S — DueDateHQ'
const description =
  '免费估算 IRS 迟报罚金：failure-to-file（5%/月，封顶 25%）、failure-to-pay（0.5%/月），以及穿透实体每人每月 $255 的罚金——每个费率都引用 irs.gov 官方来源。'
const { publishedOn, reviewedOn } = getContentDates('penalty-calculator')
const F = PENALTY_FACTS
const faq = [
  {
    q: '迟交税表 IRS 罚多少钱？',
    a: `Failure-to-file 罚金为未缴税额的每月（不足一月按一月）5%，封顶 25%。逾期超过 60 天另有最低罚金：$${F.ftfMinimumOver60DaysLate}（2025-12-31 后到期的申报）与应报税额 100% 取低者。`,
  },
  {
    q: '合伙企业 / S 公司迟报罚多少？',
    a: `每位合伙人或股东每月（不足一月按一月）$${F.passThroughPerPersonPerMonth}，上限 ${F.passThroughMaxMonths} 个月（2025-12-31 后到期的申报）——即使当年无收入、无应缴税也照罚。4 位合伙人的 1065 迟两个月 = $${F.passThroughPerPersonPerMonth} × 4 × 2 = $${(F.passThroughPerPersonPerMonth * 8).toLocaleString('en-US')}。`,
  },
  {
    q: '迟报和迟缴罚金会叠加吗？',
    a: '同月两项都适用时，failure-to-file 按该月 failure-to-pay 金额减免——合计每月 5%（4.5% + 0.5%）。五个月后 failure-to-file 达到上限，failure-to-pay 继续累计到自身 25% 上限，利息另计。',
  },
  {
    q: 'IRS 迟报罚金能减免吗？',
    a: '有可能。IRS 接受合理理由（reasonable cause）减免；近三年合规记录良好的纳税人还可申请首次减免（First Time Abate）。税款未缴清期间，利息一般不予减免。',
  },
]
const structuredData: JsonLdDocument = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${MARKETING_SITE_URL}${pathname}#webpage`,
      url: `${MARKETING_SITE_URL}${pathname}`,
      name: title,
      description,
      inLanguage: locale,
      datePublished: publishedOn,
      dateModified: reviewedOn,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: `${MARKETING_SITE_URL}/zh-CN` },
        {
          '@type': 'ListItem',
          position: 2,
          name: '迟报罚金估算器',
          item: `${MARKETING_SITE_URL}${pathname}`,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
}
const ctaHref = getStartedHref(locale)
---

<BaseLayout
  lang={locale}
  pathname={pathname}
  title={title}
  description={description}
  ogImage="/og/how-it-works.zh-CN.png"
  ogType="article"
  structuredData={structuredData}
>
  <TopNav pageMode ctaHref={ctaHref} />
  <PenaltyCalculator locale={locale} />
  <section class="pcf">
    <div class="wrap">
      <p class="m-eyebrow">FAQ</p>
      <h2 class="m-page-h2">迟报罚金常见问题</h2>
      {
        faq.map((f) => (
          <details class="pcf__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
      <p class="pcf__more">
        截止日：<a href="/zh-CN/deadline-lookup">报税截止日快查</a> · 顺延：<a
          href="/irs-disaster-relief">IRS 灾害减免跟踪</a
        >
      </p>
    </div>
  </section>
  <Footer />
</BaseLayout>

<style>
  .pcf {
    padding-block: 8px clamp(48px, 7vw, 80px);
  }
  .pcf .wrap {
    max-width: var(--m-maxw);
    margin-inline: auto;
    padding-inline: var(--m-gutter);
  }
  .pcf__item {
    border-bottom: 1px solid var(--m-hairline-2);
    padding: 14px 0;
  }
  .pcf__item summary {
    cursor: pointer;
    font-weight: 500;
    color: var(--m-ink);
  }
  .pcf__item p {
    margin: 10px 0 0;
    max-width: 70ch;
    line-height: 1.6;
    color: var(--m-ink-2);
  }
  .pcf__more {
    margin-top: 20px;
    font-size: var(--m-text-sm, 0.9rem);
    color: var(--m-muted);
  }
  .pcf__more a {
    color: var(--m-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
