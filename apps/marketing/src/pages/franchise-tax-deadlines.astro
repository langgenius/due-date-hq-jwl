---
/**
 * /franchise-tax-deadlines — state franchise / annual entity tax hub (B1a of
 * the state×tax matrix). Verified twice per row; sources on every card.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import TopNav from '../components/home/TopNav.astro'
import Footer from '../components/home/Footer.astro'
import StateFranchisePage from '../components/StateFranchisePage.astro'
import { getStartedHref } from '../lib/app-url'
import { getContentDates } from '../lib/content-metadata'
import { MARKETING_SITE_URL } from '../lib/site'
import type { JsonLdDocument } from '../lib/structured-data'

const locale = 'en'
const pathname = '/franchise-tax-deadlines'
const title = 'State Franchise Tax Due Dates (2026): TX, DE, CA & 10 More — DueDateHQ'
const description =
  'Verified 2026 franchise, privilege, and net-worth tax deadlines by state — Delaware March 1/June 1, Texas May 15, plus the states that just repealed theirs (LA, OK) — each with the official state source linked.'
const { publishedOn, reviewedOn } = getContentDates('franchise-tax-deadlines')
const faq = [
  {
    q: 'When is the Texas franchise tax due in 2026?',
    a: 'May 15 (next business day if it falls on a weekend or holiday). The no-tax-due revenue threshold is $2,650,000 for reports due in 2026–2027, and extensions run to Nov. 15 on a timely request with the required payment.',
  },
  {
    q: 'What are the Delaware franchise tax deadlines?',
    a: 'Two different dates: domestic corporations file the annual report and pay franchise tax by March 1, while LLCs and LPs pay the flat $300 annual tax by June 1 (no annual report). Foreign corporations file by June 30.',
  },
  {
    q: 'Which states have repealed their franchise tax?',
    a: 'Recently: Oklahoma (tax year 2023 was the final year, per HB1039X) and Louisiana (repealed for franchise periods beginning on or after Jan. 1, 2026, under Act 6 of the 2024 Third Extraordinary Session). Mississippi is phasing its tax out, with full repeal effective Jan. 1, 2028.',
  },
  {
    q: 'Does California still charge the $800 LLC annual tax?',
    a: 'Yes — due the 15th day of the 4th month of the LLC’s tax year, every year until the LLC is formally cancelled. The first-year exemption expired after 2023, and LLCs with California income over $250,000 also owe an estimated LLC fee by the 15th day of the 6th month.',
  },
]
const structuredData: JsonLdDocument = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${MARKETING_SITE_URL}${pathname}#webpage`,
      url: `${MARKETING_SITE_URL}${pathname}`,
      name: title,
      description,
      inLanguage: locale,
      datePublished: publishedOn,
      dateModified: reviewedOn,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${MARKETING_SITE_URL}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Franchise tax deadlines',
          item: `${MARKETING_SITE_URL}${pathname}`,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
}
const ctaHref = getStartedHref()
---

<BaseLayout
  lang={locale}
  pathname={pathname}
  title={title}
  description={description}
  ogImage="/og/coverage.en.png"
  ogType="article"
  structuredData={structuredData}
>
  <TopNav pageMode ctaHref={ctaHref} current="coverage" />
  <StateFranchisePage locale={locale} />
  <section class="sff">
    <div class="wrap">
      <p class="m-eyebrow">FAQ</p>
      <h2 class="m-page-h2">Franchise tax questions</h2>
      {
        faq.map((f) => (
          <details class="sff__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
      <p class="sff__more">
        Sales tax: <a href="/sales-tax-deadlines">state sales tax due dates</a> · Federal:{' '}
        <a href="/deadline-lookup">tax deadline lookup</a> · Cost of missing one:{' '}
        <a href="/penalty-calculator">penalty calculator</a> · Every state:{' '}
        <a href="/state-coverage">state coverage</a>
      </p>
    </div>
  </section>
  <Footer />
</BaseLayout>

<style>
  .sff {
    padding-block: 8px clamp(48px, 7vw, 80px);
  }
  .sff .wrap {
    max-width: var(--m-maxw);
    margin-inline: auto;
    padding-inline: var(--m-gutter);
  }
  .sff__item {
    border-bottom: 1px solid var(--m-hairline-2);
    padding: 14px 0;
  }
  .sff__item summary {
    cursor: pointer;
    font-weight: 500;
    color: var(--m-ink);
  }
  .sff__item p {
    margin: 10px 0 0;
    max-width: 70ch;
    line-height: 1.6;
    color: var(--m-ink-2);
  }
  .sff__more {
    margin-top: 20px;
    font-size: var(--m-text-sm, 0.9rem);
    color: var(--m-muted);
  }
  .sff__more a {
    color: var(--m-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
